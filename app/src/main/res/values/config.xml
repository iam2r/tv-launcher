<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher configuration. Edit this file, then run launcher/build-and-install.sh.
  Or leave it and push a theme instead: tools/theme.sh themes/<name> puts a config.json (same keys, see
  themes/README.md) and an optional wallpaper on the TV, and the launcher overlays it at start.
  Package names: on the TV run `pm list packages` (tools/tv.py 'pm list packages').
-->
<resources>

    <!-- Apps pinned to the dock row at the bottom, in this order. Missing apps are skipped. -->
    <!-- Empty on purpose: a published build must not arrive with someone else's apps on the Home. On a fresh
         install the nests are empty and each one says what pressing it does; MENU on a nest pins an app.
         Fill this in (package names, or through a theme's config.json) to ship your own arrangement. -->
    <string-array name="dock_apps">
    </string-array>
    <!-- With fewer dock_apps than columns (or a dock app that is not installed), the free dock slots take
         the first grid apps, so the dock never shows a gap. false leaves them empty (#162); a theme can
         set "fill_dock": false. -->
    <bool name="fill_dock">true</bool>

    <!-- Apps never shown as tiles (e.g. the Live TV app, which the Inputs menu already covers). -->
    <string-array name="hidden_apps">
    </string-array>

    <!-- The TV's Live TV / tuner app, offered at the end of the Inputs menu. Leave empty to omit. -->
    <string name="live_tv_package" translatable="false"></string>

    <!-- Some TVs give their Live TV app no leanback entry point at all, so `live_tv_package` above
         resolves to nothing (TCL Android TV 9 on China-market sets is one). This action is then sent
         to that package instead, and the app starts normally. Leave empty to omit. -->
    <string name="live_tv_action" translatable="false"></string>

    <!-- TVs with no TvInputManager have no HDMI list to read, but their own source-selection panel
         still switches inputs (TCL Android TV 9 again). When nothing could be listed, the Inputs menu
         offers one row that starts this service: component first, then action. Leave empty to omit. -->
    <string name="source_panel_service" translatable="false"></string>
    <string name="source_panel_action" translatable="false"></string>

    <!-- Inputs menu: HDMI and AV rows normally open with ACTION_VIEW on the input's channel URI, which the
         Live TV app handles. Where nothing answers that, this action is sent with the same URI instead
         (XGIMI projectors: com.xgimi.action.hdmiPlayer). Leave empty to omit. -->
    <string name="input_action" translatable="false"></string>

    <!-- Remote buttons that open Settings, by Linux scancode (HOME_KEY_SERVICE=1 build-and-install.sh). Remotes
         that send KEYCODE_SETTINGS need no entry. Some send a code Android does not map: the Xiaomi/Fengmi
         projector remote's gear button is scancode 384 (KEY_TAPE). Find yours with
         `tools/tv.py 'getevent -lt'` while pressing the button. Leave empty to omit. -->
    <integer-array name="settings_key_scancodes">
    </integer-array>
    <!-- The same by Android keycode, for buttons whose scancode is shared. TCL Google TV remotes send their
         Settings button as keycode 83 (KEYCODE_NOTIFICATION, which the stock Google TV home turned into its quick
         settings panel) on scancode 240 (KEY_UNKNOWN), the scancode several TCL buttons share. Find the keycode
         with `tools/tv.py 'logcat -v time -s InputReader:D'` while pressing the button. Leave empty to omit. -->
    <integer-array name="settings_key_keycodes">
    </integer-array>
    <!-- What those Settings buttons open: false, the TV's Settings; true, a small glass panel at the top right
         with TV settings, Display, Network, Apps (re-enable an app) and Launcher settings, over whatever is on screen.
         Both keys can also be set from a theme's config.json ("settings_key_keycodes": [83]). -->
    <bool name="settings_key_panel">false</bool>

    <!-- The dock as its own row: a lighter band, no names under the tiles, parked low on the screen with the top
         shelf above it. false makes the dock apps simply the first tiles of one plain grid (still in dock_apps
         order, no empty slots), with names under every tile and the glow behind every focused tile. -->
    <bool name="dock_row">true</bool>
    <!-- A reorder button (two arrows) in the top bar. Off by default: reordering is also in the Settings
         button's long-press menu, so it needs no extra button on screen. -->
    <bool name="reorder_button">false</bool>

    <!-- Grid rows left visible under the dock on the home screen. 0 = dock sits at the very bottom. Tiles shrink if
         the dock, its title and this many rows would not otherwise fit the screen height. -->
    <integer name="rows_below_dock">0</integer>

    <!-- The focused dock app's name in large type above the dock. false keeps only the glow, which leaves room
         for bigger tiles when rows_below_dock is 2 or 3. -->
    <bool name="dock_title">false</bool>

    <!-- Tiles per row in the grid; the dock always has this many slots. Tiles are 180dp wide at 4 columns and
         shrink to fit from 5 up (about 144dp at 5, 117dp at 6 on a 1080p TV). -->
    <integer name="columns">5</integer>

    <!-- Basic motion is on; advanced effects are opt-in in the launcher's own Settings screen. -->
    <bool name="animations">true</bool>
    <bool name="advanced_effects">false</bool>

    <!-- Optional Default-home tile; keep this key for existing themes and tile-ordering work.
         Off by default because the chooser is also available from launcher settings. -->
    <bool name="show_home_settings_shortcut">false</bool>

    <!-- Reduced motion: for TVs whose GPU cannot keep up (MediaTek MT5895 on Android 10 is the known case).
         true keeps the GPU drawing path but calms the movement: a stiff highlight spring with no bounce,
         tiles that zoom without overshoot, shorter fades and no tile entrance when Home comes back. Set it
         here or with "reduced_motion": true in a theme's config.json; false keeps the normal motion. -->
    <bool name="reduced_motion">true</bool>

    <!-- One line under the clock: CPU, free memory and free storage. Off by default; a theme can set
         "show_stats": true. Nothing is read, and the clock does not move, while this is false. -->
    <bool name="show_stats">false</bool>

    <!-- Shelf Home: the nest hops. true shows only slot_count slots instead of every app, and puts the rest
         of the apps behind the Down key: a full-screen drawer with the system apps folded into one folder.
         Each slot is filled on the TV - focus it and press MENU, or OK on an empty slot. Choices are stored in
         the launcher's home_slots.txt; dock_apps seeds the slots until one is chosen. Off by default. -->
    <bool name="shelf_mode">true</bool>
    <integer name="slot_count">5</integer>
</resources>
