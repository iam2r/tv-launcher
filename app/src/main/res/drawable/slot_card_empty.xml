<?xml version="1.0" encoding="utf-8"?>
<!-- An unfilled nest: a quiet dashed card, so an empty slot still shows where it is without shouting. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#0DFFFFFF" />
    <stroke android:width="1.5dp" android:color="#3DFFFFFF" android:dashWidth="6dp" android:dashGap="4dp" />
    <corners android:radius="15dp" />
</shape>
