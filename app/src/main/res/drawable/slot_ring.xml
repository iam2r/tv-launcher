<?xml version="1.0" encoding="utf-8"?>
<!--
  Focus ring for a nest card: a crisp 3dp white outline hugging the card, nothing else. Drawn as the card's
  foreground so it follows the card's own colour instead of covering it with a second background.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="3dp" android:color="#FFFFFFFF" />
            <corners android:radius="15dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <corners android:radius="15dp" />
        </shape>
    </item>
</selector>
