<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF101419"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="72dp"
        android:paddingEnd="72dp"
        android:paddingTop="38dp"
        android:paddingBottom="38dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/launcher_settings"
            android:textColor="#FFFFFFFF"
            android:textSize="34sp" />

        <!-- Only what a TV gets wrong: which app is Home, the system settings screen, and what this
             launcher could probe about the set. Grid columns and motion live in config.xml, where they
             are set once, rather than in a panel nobody wants to scroll. -->

        <TextView
            android:id="@+id/defaultHomeChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="28dp"
            android:text="@string/home_settings" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="@string/home_settings_help"
            android:textColor="#FFACB8C1"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvSettingsChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="18dp"
            android:text="@string/tv_settings" />

        <!-- What this launcher could probe on this TV: brand, inputs, Live TV entry, keys. Read-only, so a
             report can be read off the screen on a TV this was not tuned for. -->
        <TextView
            android:id="@+id/reportChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="18dp"
            android:text="@string/report_row" />
    </LinearLayout>
</ScrollView>
