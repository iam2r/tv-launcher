<?xml version="1.0" encoding="utf-8"?>
<!--
  The full app list of a shelf Home, shown over the launcher by the Down key and reused as the slot picker
  MENU opens on a nest: one view for both, so pinning an app looks exactly like opening one.

  A dark panel rather than a blurred copy of Home: nothing is captured, nothing is re-rendered, and the level
  change reads as a level change because the wallpaper disappears.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F20A0A0C"
    android:focusable="true"
    android:clickable="true"
    android:descendantFocusability="afterDescendants">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:paddingTop="30dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:gravity="bottom">

            <TextView
                android:id="@+id/drawerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:textColor="#FFFFFFFF"
                android:textSize="30sp"
                android:fontFamily="@font/outfit_light"
                android:letterSpacing="-0.01" />

            <TextView
                android:id="@+id/drawerHint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="18dp"
                android:layout_marginBottom="4dp"
                android:gravity="end"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="#66FFFFFF"
                android:textSize="14sp"
                android:fontFamily="@font/outfit_medium"
                android:letterSpacing="0.02" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/drawerGrid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="16dp"
            android:paddingBottom="10dp"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:descendantFocusability="afterDescendants" />
    </LinearLayout>
</FrameLayout>
